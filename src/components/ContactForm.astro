---
export interface Props {
  preselectedTopic?: string;
}

const { preselectedTopic = '' } = Astro.props;

const topics = ['Booking', 'Consultation', 'Press', 'Other'];
---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  id="contact-form"
  class="space-y-6"
>
  <!-- Netlify hidden fields -->
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Name -->
    <div class="flex flex-col gap-2">
      <label for="name" class="font-mono text-[10px] uppercase tracking-widest text-parchment/50">
        Name <span class="text-bauhaus-red" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Your name"
        class="bg-transparent border border-white/15 px-4 py-3 font-mono text-sm text-parchment placeholder:text-parchment/20 focus:border-bauhaus-red focus:outline-none transition-colors"
      />
    </div>

    <!-- Email -->
    <div class="flex flex-col gap-2">
      <label for="email" class="font-mono text-[10px] uppercase tracking-widest text-parchment/50">
        Email <span class="text-bauhaus-red" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="your@email.com"
        class="bg-transparent border border-white/15 px-4 py-3 font-mono text-sm text-parchment placeholder:text-parchment/20 focus:border-bauhaus-red focus:outline-none transition-colors"
      />
    </div>
  </div>

  <!-- Topic dropdown -->
  <div class="flex flex-col gap-2">
    <label for="topic" class="font-mono text-[10px] uppercase tracking-widest text-parchment/50">
      Topic <span class="text-bauhaus-red" aria-hidden="true">*</span>
    </label>
    <div class="relative">
      <select
        id="topic"
        name="topic"
        required
        class="w-full appearance-none bg-void border border-white/15 px-4 py-3 font-mono text-sm text-parchment focus:border-bauhaus-red focus:outline-none transition-colors cursor-pointer"
      >
        <option value="" disabled selected={!preselectedTopic}>Select a topic</option>
        {topics.map((t) => (
          <option value={t} selected={preselectedTopic === t}>{t}</option>
        ))}
      </select>
      <!-- Custom arrow -->
      <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
          <path d="M1 1L5 5L9 1" stroke="#F4F0E8" stroke-opacity="0.4" stroke-width="1.5"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Message -->
  <div class="flex flex-col gap-2">
    <label for="message" class="font-mono text-[10px] uppercase tracking-widest text-parchment/50">
      Message <span class="text-bauhaus-red" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      placeholder="Tell Trevor what's on your mind..."
      class="bg-transparent border border-white/15 px-4 py-3 font-mono text-sm text-parchment placeholder:text-parchment/20 focus:border-bauhaus-red focus:outline-none transition-colors resize-none"
    ></textarea>
  </div>

  <!-- Submit -->
  <div class="flex items-center gap-6">
    <button
      type="submit"
      class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-widest text-void bg-bauhaus-red px-8 py-4 hover:bg-bauhaus-red/85 active:bg-bauhaus-red/70 transition-colors"
    >
      Send Message
      <span aria-hidden="true">→</span>
    </button>
    <p class="font-mono text-[10px] text-parchment/30 uppercase tracking-widest">
      <span class="text-bauhaus-red">*</span> Required
    </p>
  </div>
</form>

<!-- Success message (shown via URL param) -->
<div id="form-success" class="hidden p-6 border border-bauhaus-red/30 bg-bauhaus-red/5">
  <p class="font-mono text-xs uppercase tracking-widest text-bauhaus-red mb-2">Message Received</p>
  <p class="font-serif text-base text-parchment/80">
    Thanks for reaching out. Trevor will be in touch.
  </p>
</div>

<script>
  function checkSuccess() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('success') === 'true') {
      const form = document.getElementById('contact-form');
      const success = document.getElementById('form-success');
      if (form) form.classList.add('hidden');
      if (success) success.classList.remove('hidden');
    }
  }

  checkSuccess();
  document.addEventListener('astro:page-load', checkSuccess);
</script>
