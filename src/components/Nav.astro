---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/credits', label: 'Credits' },
  { href: '/video', label: 'Video' },
  { href: '/mentorship', label: 'Mentorship' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-void/95 backdrop-blur-sm border-b border-white/5">
  <nav class="max-w-7xl mx-auto px-6 md:px-10 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" aria-label="Trevor Jones — Home">
      <div
        class="w-8 h-8 bg-bauhaus-red flex items-center justify-center flex-shrink-0 transition-colors group-hover:bg-bauhaus-red/80"
      >
        <span class="font-mono text-xs font-medium text-parchment tracking-tight">TJ</span>
      </div>
      <div class="hidden sm:block">
        <span class="font-serif text-sm text-parchment leading-none">Trevor Jones</span>
        <span class="block font-mono text-[10px] text-parchment/40 uppercase tracking-widest leading-none mt-0.5">Bassist</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`nav-link font-mono text-[11px] uppercase tracking-widest transition-colors duration-200 ${
              currentPath === link.href
                ? 'text-parchment active'
                : 'text-parchment/50 hover:text-parchment'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5 group cursor-pointer"
      style="touch-action: manipulation;"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation"
      type="button"
      onclick="void(0)"
    >
      <span class="block w-6 h-px bg-parchment transition-all duration-300 group-aria-expanded:rotate-45 group-aria-expanded:translate-y-[7px]"></span>
      <span class="block w-6 h-px bg-parchment transition-all duration-300 group-aria-expanded:opacity-0"></span>
      <span class="block w-6 h-px bg-parchment transition-all duration-300 group-aria-expanded:-rotate-45 group-aria-expanded:-translate-y-[7px]"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-white/5 bg-void"
    style="z-index: 49;"
    role="dialog"
    aria-label="Navigation menu"
  >
    <ul class="px-6 py-8 flex flex-col gap-6" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`font-mono text-sm uppercase tracking-widest transition-colors ${
              currentPath === link.href
                ? 'text-bauhaus-red'
                : 'text-parchment/60 hover:text-parchment'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  let navAbort: AbortController | null = null;

  function initNav() {
    // Tear down any previous listeners before re-registering
    if (navAbort) navAbort.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!toggle || !menu) return;

    function toggleMenu() {
      const isOpen = toggle!.getAttribute('aria-expanded') === 'true';
      toggle!.setAttribute('aria-expanded', String(!isOpen));
      menu!.classList.toggle('hidden');
    }

    // touchend with preventDefault prevents ghost click on iOS Safari
    toggle.addEventListener('touchend', (e) => {
      e.preventDefault();
      toggleMenu();
    }, { passive: false, signal } as AddEventListenerOptions);

    toggle.addEventListener('click', () => {
      toggleMenu();
    }, { signal });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle!.setAttribute('aria-expanded', 'false');
        menu!.classList.add('hidden');
      }, { signal });
    });
  }

  document.addEventListener('DOMContentLoaded', initNav);
  document.addEventListener('astro:page-load', initNav);
</script>
