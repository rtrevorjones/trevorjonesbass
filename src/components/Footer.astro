---
const year = new Date().getFullYear();
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/credits', label: 'Credits' },
  { href: '/video', label: 'Video' },
  { href: '/mentorship', label: 'Mentorship' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-white/8 mt-32">
  <!-- Red accent bar -->
  <div class="h-0.5 bg-bauhaus-red w-24 ml-6 md:ml-10 -mt-px"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      <!-- Identity -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 bg-bauhaus-red flex items-center justify-center flex-shrink-0">
            <span class="font-mono text-xs font-medium text-parchment tracking-tight">TJ</span>
          </div>
        </div>
        <p class="font-serif text-xl text-parchment mb-1">Trevor Jones</p>
        <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40">Bassist · Chicago, IL</p>
        <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40 mt-1">D'Addario Artist · GK Endorsed</p>
        <div class="flex items-center gap-4 mt-5">
          <a href="https://www.instagram.com/trevorjonesbass/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-parchment/50 hover:text-[#c8893a] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@trevorjonesbass" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-parchment/50 hover:text-[#c8893a] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav links -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-5">Navigate</p>
        <ul class="flex flex-col gap-3" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-[11px] uppercase tracking-widest text-parchment/50 hover:text-parchment transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact / CTA -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-5">Get in Touch</p>
        <p class="font-serif text-base text-parchment/70 mb-6 leading-relaxed">
          Booking inquiries, press requests, and consultation availability.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-widest text-void bg-bauhaus-red px-5 py-3 hover:bg-bauhaus-red/85 transition-colors"
        >
          Contact Trevor
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-white/8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="font-mono text-[10px] text-parchment/25 uppercase tracking-widest">
        &copy; {year} Trevor Jones. All rights reserved.
      </p>
      <p class="font-mono text-[10px] text-parchment/25 uppercase tracking-widest">
        trevorjonesbass.com
      </p>
    </div>
  </div>
</footer>
