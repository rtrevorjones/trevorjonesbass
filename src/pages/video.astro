---
import Layout from '../layouts/Layout.astro';
import music from '../data/music.json';
---

<Layout
  title="Video | Trevor Jones"
  description="Trevor Jones — Molehill (Alt. Rock), orchestral work with the Elgin Symphony Orchestra, Chicago Philharmonic, and Civic Orchestra of Chicago."
>
  <!-- ─── PAGE HERO ─────────────────────────────────────────── -->
  <section class="pt-40 pb-20 relative overflow-hidden border-b border-white/8">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-bauhaus-red" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-10 md:px-16">
      <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
        03 — Sound
      </p>
      <h1 class="font-serif italic text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-parchment">
        Video
      </h1>
    </div>
  </section>

  <!-- ─── THEATER ────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-3" data-reveal="left">
        <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
      </div>

      <div class="md:col-span-9">
        <h2 class="font-serif text-5xl md:text-7xl text-parchment mb-8 leading-tight" data-reveal>
          Theater
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal data-delay="100">
          {[
            { id: 'h4WgKdF6ZfI', title: 'Goodbye - Catch Me If You Can (Full Performance by JJ Niemann)',      caption: 'Accompanying the incredible performance of J.J. Neimann.' },
            { id: 'bk4A--453rY', title: "Don't Break The Rules | Catch Me If You Can",                          caption: 'Accompanying the great Nate Stampley and this amazing cast.' },
            { id: 'C9Lx1qZLpA8', title: 'Feed Me (Git It) | Little Shop of Horrors',                           caption: 'A fun bass line on a great scene.' },
            { id: 'LW2TtUMWRv8', title: 'The Launching: Godspeed Titanic / Titanic The Musical',                caption: 'I never tired of accompanying these magnificent voices.' },
            { id: 'dC-H0zLcDCY', title: "Love You Didn't Do Right By Me | Irving Berlin's White Christmas",    caption: 'Accompanying the incomparable Jacquelyne Jones.' },
            { id: 'iYr9Bt0ongQ', title: 'Sit Down John | 1776 at Marriott Theatre',                            caption: 'Continuo power.' },
            { id: '3BJddQiQz0Y', title: 'My White Knight | The Music Man at Marriott Theatre',                 caption: 'Accompanying the brilliant Alexandra Silber.' },
            { id: 'wf1OimlMh8s', title: 'Paciencia Y Fe | In The Heights at Marriott Theatre',                 caption: "The elegance of Irio O'Farrill, Jr.'s lines were a gift every night (RIP)." },
            { id: 'VOtOBaG09MU', title: 'Club Number/Blackout - In The Heights, Marriott Theatre',             caption: 'A rhythm section view of In the Heights with Tom Hipskind on drums and Andy Wilmoth on percussion.' },
            { id: '4G1sld7ijU4', title: 'Beautiful | Beautiful: The Carole King Musical at Marriott Theatre', caption: 'What a way to close the show every night with the incredible Kaitlyn Davis!' },
            { id: 'xB0y-MKfCQU', title: 'What You Want | Big Fish at Marriott Theatre',                       caption: 'Lucy Godinez always brings the fire.' },
            { id: 'jD0tWK3bf0A', title: 'One Second and a Million Miles | The Bridges of Madison County',      caption: 'Playing this amazing score accompanying Kathy and Nate was a pleasure.' },
            { id: 'zL6RH_sRLKU', title: 'Money, Money, Money | Mamma Mia!',                                    caption: 'Having a great time on those Rutger Gunnarsson lines.' },
            { id: 'pf2YCMyt5GY', title: 'City of Angels at Marriott Theatre',                              caption: 'One of my favorite shows to play.' },
            { id: 'xH2pY51wwnk', title: "Betsy's Getting Married | Honeymoon in Vegas",                        caption: 'It\'s always great to play with the wonderful Sam Pauly.' },
            { id: 'ABjUiA-O3AA', title: 'HERO: The Musical at Marriott Theatre',                           caption: 'It was a joy to help develop this bass book and perform it at Marriott Theatre and Asolo Rep Theatre.' },
          ].map((video) => (
            <div class="video-thumb cursor-pointer group" data-video-id={video.id}>
              <p class="font-serif text-base text-[#c8893a] leading-snug mb-3">{video.title}</p>
              <div class="relative overflow-hidden aspect-video">
                <img
                  src={`https://img.youtube.com/vi/${video.id}/hqdefault.jpg`}
                  alt=""
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-void/30 group-hover:bg-void/60 transition-colors duration-300"></div>
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <div class="w-14 h-14 rounded-full bg-bauhaus-red flex items-center justify-center shadow-lg">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="white" aria-hidden="true">
                      <polygon points="5,2 15,9 5,16" />
                    </svg>
                  </div>
                </div>
              </div>
              <p class="font-mono text-[9px] uppercase tracking-widest text-parchment/40 mt-3 leading-relaxed">
                {video.caption}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MOLEHILL ──────────────────────────────────────────── -->
  {music.bands.map((band) => (
    <section class="border-t border-white/8 max-w-7xl mx-auto px-6 md:px-10 py-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
        </div>

        <div class="md:col-span-9">
          <h2 class="font-serif text-5xl md:text-7xl text-parchment mb-8 leading-tight" data-reveal>
            {band.name}
          </h2>
          <p class="font-serif text-xl text-parchment/75 leading-relaxed mb-8 max-w-2xl" data-reveal data-delay="100">
            {band.description}
          </p>
          <p class="font-serif text-lg text-parchment/60 leading-relaxed max-w-2xl" data-reveal data-delay="150">
            "Do not be fooled by the name. Chicago's Molehill is more like a mountain constructed with big guitars, melodic keyboards, and pounding drums. Combining elements of progressive rock with pop sensibilities along with expansive and emotionally charged lyrics, this band delivers a symphonic listening experience." —<a href="https://twitter.com/JesseMenendez" target="_blank" rel="noopener noreferrer" class="text-[#c8893a] no-underline hover:underline">Jesse Menendez</a>, <a href="http://vocalo.org/" target="_blank" rel="noopener noreferrer" class="text-[#c8893a] no-underline hover:underline">Vocalo</a> and <a href="http://wbez.org/" target="_blank" rel="noopener noreferrer" class="text-[#c8893a] no-underline hover:underline">WBEZ</a>, 89.5FM and 91.5FM Chicago
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-12" data-reveal data-delay="200">
            {[
              { id: 'w9EfW0WUyUA', title: 'Molehill - Hearts on Fire' },
              { id: '-dAZw7E2XdA', title: 'Molehill - Money Life' },
              { id: 'VtQxPsvybb4', title: 'Molehill - Wildfire (SBTRKT) - Live at the Metro - Chicago, IL' },
              { id: 'V3CIFgMnoKc', title: 'Molehill - Interlude & I\'m Okay - Live in Chicago' },
              { id: 'R7-hmlp3F0w', title: 'Molehill - I Won\'t Let You Go (Snow Patrol)' },
              { id: '2uhjrNMnOtE', title: 'Molehill - Two Souls' },
              { id: 's-3ipwvaXPM', title: 'Molehill - The Repeating' },
            ].map((video) => (
              <div class="video-thumb cursor-pointer group" data-video-id={video.id}>
                <p class="font-serif text-base text-[#c8893a] leading-snug mb-3">{video.title}</p>
                <div class="relative overflow-hidden aspect-video">
                  <img
                    src={`https://img.youtube.com/vi/${video.id}/hqdefault.jpg`}
                    alt=""
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-void/30 group-hover:bg-void/60 transition-colors duration-300"></div>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-14 h-14 rounded-full bg-bauhaus-red flex items-center justify-center shadow-lg">
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="white" aria-hidden="true">
                        <polygon points="5,2 15,9 5,16" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ─── LIGHTBOX ────────────────────────────────────────── -->
  <div
    id="video-lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-void/90 hidden"
    role="dialog"
    aria-modal="true"
  >
    <button
      id="lightbox-close"
      class="absolute top-6 right-6 font-mono text-2xl text-parchment/50 hover:text-parchment transition-colors leading-none"
      aria-label="Close"
    >✕</button>
    <div class="w-full max-w-4xl px-6">
      <div class="relative aspect-video w-full">
        <iframe
          id="lightbox-iframe"
          src=""
          width="100%"
          height="100%"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 w-full h-full"
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  const lightbox  = document.getElementById('video-lightbox') as HTMLElement;
  const iframe    = document.getElementById('lightbox-iframe') as HTMLIFrameElement;
  const closeBtn  = document.getElementById('lightbox-close') as HTMLButtonElement;

  function openLightbox(id: string) {
    iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.video-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => openLightbox(thumb.dataset.videoId!));
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
