---
import Layout from '../layouts/Layout.astro';
import music from '../data/music.json';
---

<Layout
  title="Music | Trevor Jones"
  description="Trevor Jones — Molehill (Alt. Rock), orchestral work with Elgin Symphony and Grant Park Orchestra, Montreux and Vienne Jazz Festivals, Carnegie Hall."
>
  <!-- ─── PAGE HERO ─────────────────────────────────────────── -->
  <section class="pt-40 pb-20 relative overflow-hidden border-b border-white/8">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-bauhaus-red" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-10 md:px-16">
      <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
        03 — Sound
      </p>
      <h1 class="font-serif italic text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-parchment">
        Music
      </h1>
    </div>
  </section>

  <!-- ─── MOLEHILL ──────────────────────────────────────────── -->
  {music.bands.map((band) => (
    <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">
            {band.genre}
          </p>
        </div>

        <div class="md:col-span-9">
          <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-4" data-reveal>
            {band.role} · {band.status}
          </p>
          <h2 class="font-serif text-5xl md:text-7xl text-parchment mb-8 leading-tight" data-reveal>
            {band.name}
          </h2>
          <p class="font-serif text-xl text-parchment/75 leading-relaxed mb-12 max-w-2xl" data-reveal data-delay="100">
            {band.description}
          </p>

          <!-- Achievements -->
          <div class="flex flex-wrap gap-3" data-reveal data-delay="200">
            {band.achievements.map((achievement) => (
              <span class="font-mono text-[10px] uppercase tracking-widest text-parchment/60 border border-white/15 px-4 py-2">
                {achievement}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ─── ORCHESTRAL ────────────────────────────────────────── -->
  <section class="border-t border-white/8 py-28 bg-white/[0.015]">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-blue mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-blue">
            Orchestral
          </p>
        </div>

        <div class="md:col-span-9">
          <h2 class="font-serif text-4xl md:text-5xl text-parchment mb-12" data-reveal>
            Symphonic Work
          </h2>

          <div class="border border-white/8">
            {music.orchestral.map((ens, i) => (
              <div
                class="p-8 border-b last:border-b-0 border-white/8 grid grid-cols-1 sm:grid-cols-3 gap-4 hover:bg-white/2 transition-colors"
                data-reveal
                data-delay={String(i * 100)}
              >
                <div class="sm:col-span-2">
                  <p class="font-serif text-xl text-parchment mb-1">{ens.ensemble}</p>
                  {ens.note && (
                    <p class="font-mono text-[10px] text-parchment/35 leading-relaxed max-w-md">{ens.note}</p>
                  )}
                </div>
                <div class="text-left sm:text-right">
                  <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40">{ens.type}</p>
                  <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/25 mt-1">{ens.location}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── NOTABLE & FESTIVALS ───────────────────────────────── -->
  <section class="border-t border-white/8 py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Notable -->
        <div>
          <div class="mb-12" data-reveal>
            <div class="w-12 h-px bg-bauhaus-yellow mb-4" aria-hidden="true"></div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-yellow mb-3">Notable</p>
            <h2 class="font-serif text-4xl md:text-5xl text-parchment">Landmarks</h2>
          </div>

          <div class="space-y-0 border border-white/8">
            {music.notable.map((item, i) => (
              <div
                class="p-8 border-b last:border-b-0 border-white/8"
                data-reveal
                data-delay={String(i * 100)}
              >
                <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-yellow mb-3">
                  {item.year}
                </p>
                <p class="font-serif text-2xl text-parchment mb-1">{item.event}</p>
                <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40">{item.location}</p>
                {item.description && (
                  <p class="font-mono text-xs text-parchment/35 mt-3 leading-relaxed">{item.description}</p>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Festivals -->
        <div>
          <div class="mb-12" data-reveal>
            <div class="w-12 h-px bg-bauhaus-blue mb-4" aria-hidden="true"></div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-blue mb-3">International</p>
            <h2 class="font-serif text-4xl md:text-5xl text-parchment">Festivals</h2>
          </div>

          <div class="space-y-0 border border-white/8">
            {music.festivals.map((festival, i) => (
              <div
                class="p-8 border-b last:border-b-0 border-white/8"
                data-reveal
                data-delay={String(i * 120)}
              >
                <p class="font-serif text-2xl text-parchment mb-2">{festival.name}</p>
                <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40">{festival.location}</p>
                {festival.year && (
                  <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-blue mt-1">{festival.year}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PROJECTS / DOUBLE BASS HQ ────────────────────────── -->
  <section class="border-t border-white/8 py-28 bg-white/[0.015]">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">Projects</p>
        </div>

        <div class="md:col-span-9">
          {music.projects.map((project) => (
            <div class="border border-white/8 p-10" data-reveal>
              <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-bauhaus-red hidden" aria-hidden="true"></div>
              <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-2">
                {project.role}
              </p>
              <h2 class="font-serif text-3xl md:text-4xl text-parchment mb-6">{project.name}</h2>
              <p class="font-serif text-lg text-parchment/70 leading-relaxed max-w-2xl">
                {project.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
