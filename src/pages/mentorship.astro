---
import Layout from '../layouts/Layout.astro';
import consulting from '../data/consulting.json';
---

<Layout
  title="Mentorship | Trevor Jones"
  description="Trevor Jones offers limited consultations for musicians navigating a career crossroads — students, working professionals, and everyone in between."
>
  <!-- ─── PAGE HERO ─────────────────────────────────────────── -->
  <section class="pt-40 pb-20 relative overflow-hidden border-b border-white/8">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-bauhaus-red" aria-hidden="true"></div>

    <!-- Bauhaus geometric accent -->
    <div class="absolute right-0 bottom-0 w-48 h-1 bg-bauhaus-yellow/30" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-10 md:px-16">
      <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
        04 — Guidance
      </p>
      <h1 class="font-serif italic text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-parchment">
        Mentorship
      </h1>
    </div>
  </section>

  <!-- ─── BACKGROUND ──────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-3" data-reveal="left">
        <div class="w-12 h-px bg-bauhaus-yellow mb-4"></div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-yellow">
          Background
        </p>
      </div>

      <div class="md:col-span-9 max-w-3xl">
        <p class="font-serif text-xl text-parchment/80 leading-relaxed mb-8" data-reveal>
          I have dedicated a portion of my professional life to mentorship in these settings:
        </p>

        <ul class="mb-10 flex flex-col gap-3" data-reveal data-delay="100">
          {[
            'Illinois Wesleyan University (2011–2020)',
            'Leading bass studios at over half a dozen suburban Chicago schools (2008–2020)',
            'Midwest Young Artists Conservatory (2008–2020)',
            "Chicago Federation of Musicians' FEPC's Mentorship Program (2024–Present)",
          ].map((item) => (
            <li class="flex items-start gap-4">
              <span class="font-mono text-[9px] text-bauhaus-yellow mt-1.5 flex-shrink-0" aria-hidden="true">◆</span>
              <span class="font-serif text-lg text-parchment/80 leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>

        <p class="font-serif text-xl text-parchment/80 leading-relaxed mb-10" data-reveal data-delay="200">
          While I do not maintain a dedicated program anymore, I do take on a limited number of mentees with either in-person sessions if you're in Chicago or online if you are elsewhere. Please fill out the <a href="/contact" class="text-[#c8893a] no-underline hover:underline">contact sheet</a>. Let me know what you are looking for in your educational or professional life, and if I think I can support you, we can speak further.
        </p>

        <p class="font-serif text-xl text-parchment/80 leading-relaxed mb-10" data-reveal data-delay="300">
          You can listen more to my approach on these podcasts.
        </p>

        <ul class="mb-10 flex flex-col gap-3" data-reveal data-delay="400">
          {[
            { label: "That's Not Spit, It's Condensation", href: 'https://thatsnotspit.com/2020/11/04/trevor-jones/' },
            { label: 'Honesty Pill Podcast', href: 'https://podcasts.apple.com/us/podcast/ep-2-trevor-jones-on-getting-into-music-school-and/id1533313418?i=1000493474355' },
            { label: 'Contrabass Conversations Podcast', href: 'https://www.youtube.com/watch?v=VS6RaTm-Deg' },
          ].map((podcast) => (
            <li class="flex items-start gap-4">
              <span class="font-mono text-[9px] text-bauhaus-yellow mt-1.5 flex-shrink-0" aria-hidden="true">◆</span>
              <a
                href={podcast.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-serif text-lg text-[#c8893a] no-underline hover:underline leading-relaxed"
              >{podcast.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── WHAT TO EXPECT ────────────────────────────────────── -->
  <section class="border-t border-white/8 py-28 bg-white/[0.015]">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">
            What to Expect
          </p>
        </div>

        <div class="md:col-span-9">
          <h2 class="font-serif text-4xl md:text-5xl text-parchment mb-14" data-reveal>
            Possible Areas of Focus
          </h2>

          <div class="grid grid-cols-1 gap-0 border border-white/8">
            {consulting.whatToExpect.map((item, i) => (
              <div
                class="p-10 border-b last:border-b-0 border-white/8 group hover:bg-white/2 transition-colors relative"
                data-reveal
                data-delay={String(i * 120)}
              >
                <!-- Red left indicator -->
                <div
                  class="absolute left-0 top-0 bottom-0 w-0.5 bg-bauhaus-red scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"
                  aria-hidden="true"
                ></div>

                <div class="flex items-start gap-6">
                  <span class="font-mono text-[10px] text-bauhaus-red flex-shrink-0 mt-1" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <div>
                    <h3 class="font-serif text-2xl text-parchment mb-4">{item.title}</h3>
                    <p class="font-mono text-xs text-parchment/55 leading-relaxed">{item.body}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <p class="font-serif text-base text-parchment/50 leading-relaxed mt-8" data-reveal>
            Don't see what you're looking for? <span class="text-[#c8893a]">Bring your own ideas</span> — every mentorship is different.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
