---
import Layout from '../layouts/Layout.astro';
import theater from '../data/theater.json';
---

<Layout
  title="Theater | Trevor Jones"
  description="Theater credits for Chicago-based bassist Trevor Jones — House Bassist at The Marriott Theatre and substitute in Hamilton's Chicago run."
>
  <!-- ─── PAGE HERO ─────────────────────────────────────────── -->
  <section class="pt-40 pb-20 relative overflow-hidden border-b border-white/8">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-bauhaus-red" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-10 md:px-16">
      <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
        02 — Stage
      </p>
      <h1 class="font-serif italic text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-parchment">
        Theater
      </h1>
    </div>
  </section>

  <!-- ─── CURRENT POSITION ──────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-3" data-reveal="left">
        <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">Current Position</p>
      </div>

      <div class="md:col-span-9">
        <div class="border border-white/8 p-10 relative" data-reveal>
          <!-- Red left accent -->
          <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-bauhaus-red" aria-hidden="true"></div>

          <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-6">
            {theater.currentPosition.location}
          </p>
          <h2 class="font-serif text-3xl md:text-4xl text-parchment mb-2 leading-tight">
            {theater.currentPosition.venue}
          </h2>
          <p class="font-mono text-xs uppercase tracking-widest text-bauhaus-red mb-8">
            {theater.currentPosition.title}
          </p>
          <p class="font-serif text-lg text-parchment/70 leading-relaxed max-w-2xl">
            {theater.currentPosition.description}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED CREDIT ───────────────────────────────────── -->
  {theater.featured.map((credit) => (
    <section class="border-t border-white/8 py-28 bg-white/[0.015]">
      <div class="max-w-7xl mx-auto px-6 md:px-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
          <div class="md:col-span-3" data-reveal="left">
            <div class="w-12 h-px bg-bauhaus-blue mb-4"></div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-blue">Featured</p>
          </div>

          <div class="md:col-span-9">
            <div class="border border-bauhaus-blue/20 p-10 relative" data-reveal>
              <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-bauhaus-blue" aria-hidden="true"></div>

              <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-6">
                {credit.city} · {credit.year}
              </p>
              <h2 class="font-serif text-3xl md:text-4xl text-parchment mb-2 leading-tight">
                {credit.show}
              </h2>
              <p class="font-mono text-xs uppercase tracking-widest text-bauhaus-blue mb-2">
                {credit.role}
              </p>
              <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/40 mb-8">
                {credit.venue}
              </p>
              <p class="font-serif text-lg text-parchment/70 leading-relaxed max-w-2xl">
                {credit.description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ─── ALL CREDITS ───────────────────────────────────────── -->
  <section class="border-t border-white/8 py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="mb-16" data-reveal>
        <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-3">Full Listing</p>
        <h2 class="font-serif text-4xl md:text-5xl text-parchment">Credits</h2>
      </div>

      <!-- Desktop table -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b border-white/15">
              <th class="text-left pb-4 font-mono text-[10px] uppercase tracking-widest text-parchment/30 pr-8">
                Production
              </th>
              <th class="text-left pb-4 font-mono text-[10px] uppercase tracking-widest text-parchment/30 pr-8">
                Venue
              </th>
              <th class="text-left pb-4 font-mono text-[10px] uppercase tracking-widest text-parchment/30 pr-8">
                Role
              </th>
              <th class="text-left pb-4 font-mono text-[10px] uppercase tracking-widest text-parchment/30">
                Year
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {theater.credits.map((credit, i) => (
              <tr
                class="hover:bg-white/2 transition-colors"
                data-reveal
                data-delay={String((i % 6) * 60)}
              >
                <td class="py-5 pr-8">
                  <span class="font-serif text-lg text-parchment">{credit.show}</span>
                  {credit.note && (
                    <span class="block font-mono text-[9px] text-parchment/30 uppercase tracking-wider mt-1">
                      {credit.note}
                    </span>
                  )}
                </td>
                <td class="py-5 pr-8">
                  <span class="font-mono text-xs text-parchment/60">{credit.venue}</span>
                  <span class="block font-mono text-[9px] text-parchment/30 mt-1">{credit.city}</span>
                </td>
                <td class="py-5 pr-8">
                  <span class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">
                    {credit.role}
                  </span>
                </td>
                <td class="py-5">
                  <span class="font-mono text-xs text-parchment/50">{credit.year}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile cards -->
      <div class="md:hidden space-y-0 border border-white/8">
        {theater.credits.map((credit, i) => (
          <div
            class="p-6 border-b last:border-b-0 border-white/8"
            data-reveal
            data-delay={String((i % 4) * 80)}
          >
            <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-1">
              {credit.role} · {credit.year}
            </p>
            <p class="font-serif text-xl text-parchment mb-1">{credit.show}</p>
            <p class="font-mono text-xs text-parchment/40">{credit.venue}, {credit.city}</p>
            {credit.note && (
              <p class="font-mono text-[9px] text-parchment/25 uppercase tracking-wider mt-2">
                {credit.note}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────── -->
  <section class="py-24 border-t border-white/8 text-center">
    <div class="max-w-7xl mx-auto px-6 md:px-10" data-reveal>
      <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-5">Inquiries</p>
      <p class="font-serif italic text-3xl md:text-4xl text-parchment mb-8">
        Booking inquiries welcome.
      </p>
      <a
        href="/contact?topic=Booking"
        class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-widest text-void bg-bauhaus-red px-8 py-4 hover:bg-bauhaus-red/85 transition-colors"
      >
        Booking Inquiry <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
