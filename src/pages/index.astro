---
import Layout from '../layouts/Layout.astro';
import bio from '../data/bio.json';
import { parseLinks } from '../utils/parseLinks';
---

<Layout
  title="Trevor Jones | Bassist — Chicago"
  description={bio.tagline}
>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="pt-16 border-b border-white/8">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid grid-cols-1 md:grid-cols-2 gap-0 min-h-[520px]">

      <!-- Left: name and role -->
      <div class="flex flex-col justify-center py-16 md:py-0 md:pr-12">
        <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
          Chicago, IL
        </p>
        <h1 class="font-serif italic text-[clamp(2.8rem,5.5vw,6rem)] leading-[0.9] text-parchment mb-8 whitespace-nowrap">
          Trevor Jones
        </h1>
        <div class="flex items-center gap-4 mb-8" aria-hidden="true">
          <div class="h-px bg-bauhaus-red w-12"></div>
          <div class="w-2 h-2 bg-bauhaus-red rotate-45 flex-shrink-0"></div>
        </div>
        <p class="font-mono text-xs md:text-sm uppercase tracking-widest text-parchment/70">
          Bassist
        </p>
      </div>

      <!-- Right: collage -->
      <div class="flex items-center justify-center bg-void py-8 md:py-12">
        <div class="flex gap-3 w-full max-w-md px-4 md:px-0">
          <!-- Headshot: large, left side -->
          <div class="flex-[2]">
            <img
              src="/trevor_headshot.jpg"
              alt="Trevor Jones"
              class="w-full h-full object-contain rounded-lg shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_4px_20px_rgba(0,0,0,0.6)]"
              style="filter: brightness(0.92) contrast(1.05) saturate(0.9);"
            />
          </div>
          <!-- Key bass + bass guitar: equal size, stacked right side -->
          <div class="flex-[1] flex flex-col gap-3">
            <div class="flex-1">
              <img
                src="/trevor_keybass.jpg"
                alt="Trevor Jones at the keys and bass"
                class="w-full h-full object-contain rounded-lg shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_4px_20px_rgba(0,0,0,0.6)]"
                style="filter: brightness(0.92) contrast(1.05) saturate(0.9);"
              />
            </div>
            <div class="flex-1">
              <img
                src="/trevor_bassguitar.jpg"
                alt="Trevor Jones with bass guitar"
                class="w-full h-full object-contain rounded-lg shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_4px_20px_rgba(0,0,0,0.6)]"
                style="filter: brightness(0.92) contrast(1.05) saturate(0.9);"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── INTRODUCTION ─────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
      <!-- Label column -->
      <div class="md:col-span-3" data-reveal="left">
        <div class="flex items-center gap-3 md:flex-col md:items-start md:gap-0">
          <div class="w-12 h-px bg-bauhaus-red md:mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">
            About
          </p>
        </div>
      </div>

      <!-- Content column -->
      <div class="md:col-span-9">
        {bio.bio.map((paragraph, i) => (
          <p
            class={`font-serif text-parchment leading-relaxed ${i === 0 ? 'text-2xl md:text-3xl mb-8' : 'text-xl text-parchment/80 mt-6'}`}
            data-reveal
            data-delay={String(i * 100)}
            set:html={parseLinks(paragraph)}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>
