---
import Layout from '../layouts/Layout.astro';
import consulting from '../data/consulting.json';
---

<Layout
  title="Consulting | Trevor Jones"
  description="Trevor Jones offers limited consultations for musicians navigating a career crossroads — students, working professionals, and everyone in between."
>
  <!-- ─── PAGE HERO ─────────────────────────────────────────── -->
  <section class="pt-40 pb-20 relative overflow-hidden border-b border-white/8">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-bauhaus-red" aria-hidden="true"></div>

    <!-- Bauhaus geometric accent -->
    <div class="absolute right-0 bottom-0 w-48 h-1 bg-bauhaus-yellow/30" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-10 md:px-16">
      <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red mb-8">
        04 — Guidance
      </p>
      <h1 class="font-serif italic text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-parchment">
        Consulting
      </h1>
    </div>
  </section>

  <!-- ─── SCHOLARSHIP ROADMAP ───────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-3" data-reveal="left">
        <div class="w-12 h-px bg-bauhaus-yellow mb-4"></div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-yellow">
          Background
        </p>
      </div>

      <div class="md:col-span-9">
        <h2 class="font-serif text-4xl md:text-5xl text-parchment mb-8 leading-tight" data-reveal>
          {consulting.headline}
        </h2>
        <p class="font-serif text-xl md:text-2xl text-parchment/80 leading-relaxed max-w-3xl" data-reveal data-delay="100">
          {consulting.description}
        </p>
      </div>
    </div>
  </section>

  <!-- ─── DIVIDER BAR ───────────────────────────────────────── -->
  <div class="flex items-center max-w-7xl mx-auto px-6 md:px-10 mb-0" aria-hidden="true">
    <div class="h-px flex-1 bg-white/8"></div>
    <div class="w-3 h-3 bg-bauhaus-yellow rotate-45 mx-4"></div>
    <div class="h-px flex-1 bg-white/8"></div>
  </div>

  <!-- ─── WHAT TO EXPECT ────────────────────────────────────── -->
  <section class="border-t border-white/8 py-28 bg-white/[0.015]">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-3" data-reveal="left">
          <div class="w-12 h-px bg-bauhaus-red mb-4"></div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-bauhaus-red">
            What to Expect
          </p>
        </div>

        <div class="md:col-span-9">
          <h2 class="font-serif text-4xl md:text-5xl text-parchment mb-14" data-reveal>
            Areas of Focus
          </h2>

          <div class="grid grid-cols-1 gap-0 border border-white/8">
            {consulting.whatToExpect.map((item, i) => (
              <div
                class="p-10 border-b last:border-b-0 border-white/8 group hover:bg-white/2 transition-colors relative"
                data-reveal
                data-delay={String(i * 120)}
              >
                <!-- Red left indicator -->
                <div
                  class="absolute left-0 top-0 bottom-0 w-0.5 bg-bauhaus-red scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"
                  aria-hidden="true"
                ></div>

                <div class="flex items-start gap-6">
                  <span class="font-mono text-[10px] text-bauhaus-red flex-shrink-0 mt-1" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <div>
                    <h3 class="font-serif text-2xl text-parchment mb-4">{item.title}</h3>
                    <p class="font-mono text-xs text-parchment/55 leading-relaxed">{item.body}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── AVAILABILITY NOTE ─────────────────────────────────── -->
  <section class="border-t border-white/8 py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="flex items-center gap-6" data-reveal>
        <div class="w-2 h-2 bg-bauhaus-yellow rotate-45 flex-shrink-0" aria-hidden="true"></div>
        <p class="font-mono text-xs uppercase tracking-widest text-parchment/50">
          {consulting.availability}
        </p>
      </div>
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────── -->
  <section class="border-t border-white/8 py-32">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-7" data-reveal>
          <p class="font-mono text-[10px] uppercase tracking-widest text-parchment/30 mb-4">
            Ready to begin?
          </p>
          <h2 class="font-serif italic text-4xl md:text-6xl text-parchment mb-6 leading-tight">
            {consulting.subheadline}
          </h2>
          <p class="font-serif text-lg text-parchment/60 leading-relaxed">
            Use the contact form to introduce yourself and describe where you are in your journey. Trevor reads every message.
          </p>
        </div>

        <div class="md:col-span-5 flex flex-col items-start md:items-end gap-4" data-reveal data-delay="150">
          <a
            href={`/contact?topic=${consulting.ctaTopic}`}
            class="inline-flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-void bg-bauhaus-red px-10 py-5 hover:bg-bauhaus-red/85 transition-colors"
          >
            {consulting.ctaText}
            <span aria-hidden="true">→</span>
          </a>
          <p class="font-mono text-[9px] uppercase tracking-widest text-parchment/25">
            Select "Consultation" as the topic
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
